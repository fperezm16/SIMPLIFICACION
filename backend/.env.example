# Copia este archivo como backend/.env y reemplaza los valores.
# No subas backend/.env a Git.
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/formulario
PORT=4000
JWT_SECRET=cambia_esta_clave_por_una_segura
BACKEND_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development
ALLOW_DEV_AUTH_LINKS=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOW_LOCAL_BYPASS=false
# SMTP institucional
SMTP_HOST=mail.dgac.gob.gt
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sistema.pruebas@dgac.gob.gt
SMTP_PASS=
SMTP_FROM_EMAIL=sistema.pruebas@dgac.gob.gt
SMTP_FROM_NAME=Formulario TG DGAC
EMAIL_VALIDATE_MX=false

# Seguridad para creación de solicitudes
# Máximo permitido por cuenta dentro de la ventana indicada.
SUBMISSION_RATE_LIMIT_MAX=10
SUBMISSION_RATE_LIMIT_WINDOW_MINUTES=60
# Bloquea una solicitud idéntica creada por la misma cuenta durante este intervalo.
SUBMISSION_DUPLICATE_WINDOW_SECONDS=120
