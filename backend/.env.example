# Copia este archivo como backend/.env y reemplaza los valores.
# No subas backend/.env a Git.
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/formulario
PORT=4000
JWT_SECRET=cambia_esta_clave_por_una_segura
BACKEND_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development
ALLOW_DEV_AUTH_LINKS=false
#RECAPTCHA_SITE_KEY=
#RECAPTCHA_SECRET_KEY=
#RECAPTCHA_ALLOW_LOCAL_BYPASS=false

# SMTP institucional
SMTP_HOST=mail.dgac.gob.gt
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sistema.pruebas@dgac.gob.gt
SMTP_PASS=
SMTP_FROM_EMAIL=sistema.pruebas@dgac.gob.gt
SMTP_FROM_NAME=Formulario TG DGAC
EMAIL_VALIDATE_MX=false

# NeoNet testing
NEOPAY_USE_MOCK=true
NEOPAY_URL=
NEOPAY_MERCHANT_USER=
NEOPAY_MERCHANT_PASSWD=
NEOPAY_PAYMENTGW_IP=
NEOPAY_MERCHANT_SERVER_IP=
NEOPAY_TERMINAL_ID=
NEOPAY_CARD_ACQ_ID=
NEOPAY_3DS_TEST_EMAIL=3ds.testing@dgac.local
NEOPAY_3DS_TEST_PHONE=55554444
NEOPAY_3DS_TEST_ADDRESS=AVENIDA REFORMA ZONA 10
NEOPAY_3DS_DEBUG=false


# Firma electronica
SIGNER_PROVIDER_NAME=infile
SIGNER_PROVIDER_URL=https://signer.infile.com/api/v3/firma_documentos/firmar_documento
SIGNER_ACCESS_KEY=
# Rubrica institucional global en Base64; no colocar valores reales en este archivo.
SIGNER_RUBRIC_BASE64=
SIGNER_DEFAULT_CONCEPT=Firma de documento
SIGNER_DEFAULT_PLACE=Guatemala, Guatemala
SIGNER_REQUEST_TYPE=PDF Especial
SIGNER_APPEARANCE=GRAPHIC_AND_DESCRIPTION
SIGNER_FONT_SIZE=-2
SIGNER_SYNC=true
SIGNER_CLOSE=true
SIGNER_TIMEOUT_MS=60000
SIGNER_CALLBACK_URL=
SIGNER_SHOW_DN=false
SIGNER_SHOW_PROFESSION=false
SIGNER_SHOW_POSITION=false
SIGNER_SHOW_COMPANY=false
